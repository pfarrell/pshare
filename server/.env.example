# Local development — copy this to .env and fill in values

NODE_ENV=development

# Local PostgreSQL database (created by scripts/setup-local-dev.sh)
BEMUSED_DB=postgres://localhost/bemused_dev

# Port for the API server (Vite proxies /api to this in dev)
PORT=3939

# Leave empty in dev — server generates http://localhost:PORT stream URLs
# Set to https://patf.com/pshare in production
BEMUSED_PATH=

# Directory where processed audio files are stored after upload
# In production this is an fstab-mounted NAS path
# Locally: created by scripts/setup-local-dev.sh
BEMUSED_UPLOAD_PATH=/home/pfarrell/bemused-dev/music

# Uncomment to proxy audio streams to production instead of serving local files
# Useful if you don't have local music files yet
# BEMUSED_DEV=https://patf.com/pshare

# Local MusicBrainz mirror (artist/artist_credit/release/release_group/medium
# tables imported from the official mbdump). Used for artist/release MBID
# lookups, admin search, and the track-edit "Fill from MusicBrainz" action
# instead of calling musicbrainz.org's rate-limited web API. See
# server/src/db/musicbrainzDb.ts.
MUSICBRAINZ_DB=

# API keys — get your own at last.fm/api and fanart.tv
LASTFM_API_KEY=your_lastfm_api_key_here
FANART_API_KEY=your_fanart_api_key_here

# AcoustID API key — get your own at acoustid.org/api-key. Used to resolve
# recording-level MusicBrainz IDs from local Chromaprint fingerprints
# (server/src/services/acoustid.ts). Requires the fpcalc system binary to
# be installed — see server/PACKAGES_TO_INSTALL.md.
ACOUSTID_API_KEY=your_acoustid_api_key_here

# Recall integration (album notes) — see docs pushed to Recall, folio
# "Album Notes via Recall"
#
# Base URL of the Recall deployment this bemused instance talks to
RECALL_API_URL=https://patf.com/recall
#
# Must exactly match the URL bemused registers with Recall's cli-auth
# allowlist (see the companion issue in the recall repo). In dev this is
# your local backend's own callback route.
RECALL_CALLBACK_URL=http://localhost:3939/auth/recall/callback
#
# 32-byte key, hex-encoded (64 chars), used to encrypt stored Recall tokens.
# Generate with: openssl rand -hex 32
RECALL_TOKEN_ENCRYPTION_KEY=
#
# Public base URL of the bemused frontend, used to build the backlink footer
# appended to note content stored in Recall. In prod: https://patf.com/pshare/app
BEMUSED_PUBLIC_URL=http://localhost:5173

# Google OAuth (shared client with recall) — see
# docs/superpowers/specs/2026-07-29-google-oauth-shared-client-design.md
#
# Same GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET already configured in recall's
# shared/.env — do NOT create a second Google Cloud OAuth client. Get the
# values from recall's env, or from Google Cloud Console if unavailable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Browser-facing base URL this backend's auth routes are reachable at
# through whatever sits in front of it (Vite proxy in dev, nginx in prod).
# The full redirect_uri registered with Google is
# "${GOOGLE_REDIRECT_BASE}/auth/google/callback".
# Dev (Vite proxies /api -> this backend, stripping the /api prefix):
GOOGLE_REDIRECT_BASE=http://localhost:5173/api
# Prod value: https://patf.com/bemused/api

# Resend (password reset emails) — get an API key at resend.com after
# verifying the patf.com sending domain there.
RESEND_API_KEY=
EMAIL_FROM=P·Share <noreply@patf.com>
